# Copy this to .env for local runs, or set these as GitHub Actions secrets.
# NEVER commit a real .env file.

# Polygon wallet private key that holds your USDC and is registered with Polymarket.
# Use a DEDICATED wallet for this bot only — never your main wallet.
POLYGON_PRIVATE_KEY=0xyourprivatekeyhere

# Polymarket CLOB API credentials (generated once via py-clob-client's
# create_or_derive_api_creds() using the wallet above — see README).
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Polymarket CLOB host (mainnet)
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Your Polymarket "deposit wallet" / proxy address — the address that actually
# holds your USDC and appears in your Polymarket portfolio. This is usually
# DIFFERENT from your raw MetaMask/wallet address. Find it in your Polymarket
# account/profile settings. Required for most accounts as of Polymarket's
# 2026 deposit-wallet migration.
POLYMARKET_FUNDER_ADDRESS=
# 0 = EOA, 1 = POLY_PROXY (email/Magic-link), 2 = POLY_GNOSIS_SAFE, 3 = POLY_1271.
# Leave blank to let the library pick a default (usually 0/EOA).
POLYMARKET_SIGNATURE_TYPE=

# Anthropic API key, used by the sentiment agent
ANTHROPIC_API_KEY=sk-ant-yourkeyhere
